# Public (safe to expose to the browser) — used by the Next.js frontend
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Optional — leave
# unset locally; GA script only loads when this is present.
NEXT_PUBLIC_GA_ID=

# Server-only — used ONLY by scripts/sync-jobs.js (GitHub Actions secrets)
# NEVER prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
